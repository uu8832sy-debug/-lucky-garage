rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function emailIs(value) { return signedIn() && request.auth.token.email == value; }
    function isOwnerEmail() { return emailIs('uu8832sr@gmail.com'); }
    function isJerryAdminEmail() { return emailIs('a0975607339@gmail.com'); }

    function legacyAdmin() {
      return signedIn() && (
        isOwnerEmail()
        || request.auth.uid == 'rN911472GUXjc1IYToSPhgf6zbs2'
        || request.auth.uid == 'iRdFBpDpXcNklIQ2tzP8kP1lDu42'
        || request.auth.uid == 'azMaRtblP0VevIvEQQDG6OZj5wh1'
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true)
      );
    }

    function hasTenantAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminAccounts/$(request.auth.uid)).data.enabled == true;
    }
    function accountData() {
      return get(/databases/$(database)/documents/adminAccounts/$(request.auth.uid)).data;
    }
    function accountRole() {
      return hasTenantAccount() ? accountData().get('role', 'admin') : null;
    }
    function accountShopId() {
      return hasTenantAccount()
        ? accountData().get('shopId', accountData().get('shopID', accountData().get('shopid', accountData().get('shopld', ''))))
        : '';
    }
    function belongsTo(shopId) {
      return (shopId == 'jerry' && isJerryAdminEmail()) || (hasTenantAccount() && accountShopId() == shopId);
    }
    function isPlatformOwner() {
      return isOwnerEmail() || (hasTenantAccount() && accountRole() == 'platformOwner');
    }
    function isShopManager(shopId) {
      return isPlatformOwner() || (belongsTo(shopId) && (accountRole() == 'owner' || accountRole() == 'admin')) || (shopId == 'jerry' && isJerryAdminEmail());
    }
    function isShopStaff(shopId) {
      return belongsTo(shopId) && accountRole() == 'staff';
    }
    function canOperateShop(shopId) {
      return isShopManager(shopId) || isShopStaff(shopId);
    }
    function isLegacyXiaoyuManager() {
      return legacyAdmin() || (hasTenantAccount() && accountShopId() == 'xiaoyu' && (accountRole() == 'platformOwner' || accountRole() == 'owner' || accountRole() == 'admin'));
    }
    function isLegacyXiaoyuStaff() {
      return hasTenantAccount() && accountShopId() == 'xiaoyu' && accountRole() == 'staff';
    }
    function canOperateLegacyXiaoyu() {
      return isLegacyXiaoyuManager() || isLegacyXiaoyuStaff();
    }

    function validPublicOrder(orderId) {
      return request.resource.data.orderId == orderId
        && request.resource.data.orderNo == orderId
        && request.resource.data.source is string
        && (request.resource.data.source == 'official-store' || request.resource.data.source == 'official-store-plate')
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 1
        && request.resource.data.customerName.size() <= 40
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 3
        && request.resource.data.address.size() <= 180
        && request.resource.data.model is string
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 300000
        && request.resource.data.createdAt == request.time;
    }
    function validShopPublicOrder(orderId, shopId) { return validPublicOrder(orderId) && request.resource.data.shopId == shopId; }
    function validInstallmentLead() {
      return request.resource.data.eventType is string
        && (request.resource.data.eventType == 'trial' || request.resource.data.eventType == 'line_intent')
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 8
        && request.resource.data.sessionId.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^09[0-9]{8}$')
        && request.resource.data.modelId is string
        && request.resource.data.modelName is string
        && request.resource.data.style is string
        && request.resource.data.batteryKey is string
        && (request.resource.data.batteryKey == 'lead' || request.resource.data.batteryKey == 'ternary' || request.resource.data.batteryKey == 'lifepo4')
        && request.resource.data.batteryLabel is string
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 300000
        && request.resource.data.term is int
        && (request.resource.data.term == 3 || request.resource.data.term == 6 || request.resource.data.term == 9 || request.resource.data.term == 12 || request.resource.data.term == 18 || request.resource.data.term == 24 || request.resource.data.term == 30 || request.resource.data.term == 36)
        && request.resource.data.monthly is int
        && request.resource.data.monthly >= 0
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.eligibilityChecked is bool
        && request.resource.data.source == 'website-installment-free-v327'
        && request.resource.data.page is string
        && request.resource.data.userAgent is string
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // 小宇微電舊版根目錄資料
    match /products/{productId} {
      allow read: if true;
      allow create, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
    }
    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isLegacyXiaoyuManager();
    }
    match /deliveryCases/{caseId} {
      allow read: if true;
      allow create, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
    }
    match /orders/{orderId} {
      allow read, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
      allow create: if canOperateLegacyXiaoyu() || validPublicOrder(orderId);
    }
    match /onlineOrders/{orderId} {
      allow read, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
      allow create: if canOperateLegacyXiaoyu() || validPublicOrder(orderId);
    }
    match /installmentLeads/{leadId} {
      allow create: if validInstallmentLead();
      allow read: if canOperateLegacyXiaoyu();
      allow update, delete: if isLegacyXiaoyuManager();
    }
    match /warranties/{warrantyId} {
      allow get: if canOperateLegacyXiaoyu() || resource.data.published == true;
      allow list: if canOperateLegacyXiaoyu();
      allow create, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
    }
    match /receipts/{receiptId} {
      allow read, create, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
    }
    match /sales/{saleId} {
      allow read, create, update: if canOperateLegacyXiaoyu();
      allow delete: if isLegacyXiaoyuManager();
    }
    match /campaigns/{campaignId} {
      allow read: if canOperateLegacyXiaoyu();
      allow create, update, delete: if isLegacyXiaoyuManager();
    }
    match /drawCodes/{codeId} {
      allow read: if canOperateLegacyXiaoyu();
      allow create, update, delete: if isLegacyXiaoyuManager();
    }
    match /auditLogs/{logId} {
      allow create: if canOperateLegacyXiaoyu()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.shopId == 'xiaoyu'
        && request.resource.data.createdAt == request.time;
      allow read: if isLegacyXiaoyuManager();
      allow update, delete: if false;
    }

    match /adminAccounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if isPlatformOwner();
    }

    match /shops/{shopId} {
      allow read: if resource.data.public == true || belongsTo(shopId) || isPlatformOwner();
      allow create, update, delete: if isPlatformOwner();

      match /products/{productId} {
        allow read: if true;
        allow create, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
      }
      match /siteSettings/{docId} {
        allow read: if true;
        allow create, update, delete: if isShopManager(shopId);
      }
      match /deliveryCases/{caseId} {
        allow read: if true;
        allow create, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
      }
      match /orders/{orderId} {
        allow read, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
        allow create: if canOperateShop(shopId) || validShopPublicOrder(orderId, shopId);
      }
      match /onlineOrders/{orderId} {
        allow read, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
        allow create: if canOperateShop(shopId) || validShopPublicOrder(orderId, shopId);
      }
      match /installmentLeads/{leadId} {
        allow read: if canOperateShop(shopId);
        allow update, delete: if isShopManager(shopId);
        allow create: if request.resource.data.shopId == shopId && validInstallmentLead();
      }
      match /warranties/{warrantyId} {
        allow get: if canOperateShop(shopId) || resource.data.published == true;
        allow list: if canOperateShop(shopId);
        allow create, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
      }
      match /receipts/{receiptId} {
        allow read, create, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
      }
      match /sales/{saleId} {
        allow read, create, update: if canOperateShop(shopId);
        allow delete: if isShopManager(shopId);
      }
      match /campaigns/{campaignId} {
        allow read: if canOperateShop(shopId);
        allow create, update, delete: if isShopManager(shopId);
      }
      match /drawCodes/{codeId} {
        allow read: if canOperateShop(shopId);
        allow create, update, delete: if isShopManager(shopId);
      }
      match /auditLogs/{logId} {
        allow create: if canOperateShop(shopId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.shopId == shopId
          && request.resource.data.createdAt == request.time;
        allow read: if isShopManager(shopId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
