rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'uu8832sr@gmail.com';
    }

    function isAdmin() {
      return signedIn() && (
        isOwnerEmail()
        || request.auth.uid == 'rN911472GUXjc1IYToSPhgf6zbs2'
        || request.auth.uid == 'iRdFBpDpXcNklIQ2tzP8kP1lDu42'
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true
        )
      );
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /campaigns/{campaignId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.active is bool
        && request.resource.data.algorithm == 'sha256-v1'
        && request.resource.data.seed is string
        && request.resource.data.name is string
        && request.resource.data.prizes is list;
      allow update, delete: if false;
    }

    match /drawCodes/{codeHash} {
      allow get: if signedIn() && (
        resource.data.used == false
        || resource.data.usedBy == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'code', 'campaignId', 'active', 'used', 'usedBy', 'usedAt',
          'selectedGarage', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'code', 'campaignId', 'active', 'used', 'usedBy', 'usedAt',
          'selectedGarage', 'createdAt', 'createdBy'
        ])
        && request.resource.data.code is string
        && request.resource.data.campaignId is string
        && request.resource.data.active == true
        && request.resource.data.used == false
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && request.resource.data.selectedGarage == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId));
      allow update: if (
        isAdmin()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool
      ) || (
        signedIn()
        && resource.data.active == true
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'used', 'usedBy', 'usedAt', 'selectedGarage'
        ])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && request.resource.data.selectedGarage is int
        && request.resource.data.selectedGarage >= 1
        && request.resource.data.selectedGarage <= 9
      );
      allow delete: if false;
    }

    // 私人訂單與收據：僅管理員可讀寫。
    match /orders/{orderId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read, create, update, delete: if isAdmin();
    }

    // 電子保固卡：公開頁只可用正確編號讀取已發布資料；禁止公開列出全部保固卡。
    match /warranties/{warrantyId} {
      allow get: if isAdmin() || resource.data.published == true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
