rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function emailIs(value) {
      return signedIn() && request.auth.token.email == value;
    }

    function tenantAccount() {
      return firestore.get(/databases/(default)/documents/adminAccounts/$(request.auth.uid));
    }

    function tenantEnabled() {
      return signedIn() && tenantAccount().data.enabled == true;
    }

    function accountRole() {
      return tenantEnabled() ? tenantAccount().data.get('role', 'admin') : '';
    }

    function accountShopId() {
      return tenantEnabled()
        ? tenantAccount().data.get('shopId', tenantAccount().data.get('shopID', tenantAccount().data.get('shopid', tenantAccount().data.get('shopld', ''))))
        : '';
    }

    function legacyAdmin() {
      return signedIn() && (
        emailIs('uu8832sr@gmail.com')
        || request.auth.uid == 'rN911472GUXjc1IYToSPhgf6zbs2'
        || request.auth.uid == 'iRdFBpDpXcNklIQ2tzP8kP1lDu42'
        || request.auth.uid == 'azMaRtblP0VevIvEQQDG6OZj5wh1'
        || firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled == true
      );
    }

    function isJerryAdminEmail() {
      return emailIs('a0975607339@gmail.com');
    }

    function belongsTo(shopId) {
      return (shopId == 'jerry' && isJerryAdminEmail()) || (tenantEnabled() && accountShopId() == shopId);
    }

    function isPlatformOwner() {
      return signedIn() && (
        emailIs('uu8832sr@gmail.com')
        || (tenantEnabled() && accountRole() == 'platformOwner')
      );
    }

    function canOperateLegacyXiaoyu() {
      return legacyAdmin() || (
        tenantEnabled()
        && accountShopId() == 'xiaoyu'
        && (accountRole() == 'staff' || accountRole() == 'admin' || accountRole() == 'owner' || accountRole() == 'platformOwner')
      );
    }

    function validImageWrite() {
      return request.resource == null || (
        request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
      );
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if canOperateLegacyXiaoyu() && validImageWrite();
    }

    match /cases/{caseId}/{fileName} {
      allow read: if true;
      allow write: if canOperateLegacyXiaoyu() && validImageWrite();
    }

    match /shops/{shopId}/products/{productId}/{fileName} {
      allow read: if true;
      allow write: if (belongsTo(shopId) || isPlatformOwner()) && validImageWrite();
    }

    match /shops/{shopId}/cases/{caseId}/{fileName} {
      allow read: if true;
      allow write: if (belongsTo(shopId) || isPlatformOwner()) && validImageWrite();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
